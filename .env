# =====================================================================
# BRAIN SERVICE CONFIGURATION
# =====================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8001

USE_DIRECT_DB=true
PGHOST=localhost
PGPORT=5432
PGDATABASE=micro_bank
PGUSER=postgres
PGPASSWORD=darika_2006

# Replace this with the REAL customer_id returned by SELECT customer_id FROM customers above!
DEFAULT_DEMO_CUSTOMER_ID=00000000-0000-0000-0000-000000000001
BANK_API_BASE_URL=http://172.16.149.230:8000
BANK_API_TIMEOUT_SECONDS=5.0

# =====================================================================
# ASR / SPEECH ENGINE CONFIGURATION
# =====================================================================
ASR_MODE=http
ASR_BASE_URL=http://127.0.0.1:8002
ASR_TIMEOUT_SECONDS=30.0
ASR_ENDPOINT_PATH=/api/v1/transcribe
TTS_ENABLED=false


# =====================================================================
# PRIMARY LLM: FRIEND'S GPU (RTX 5050 / Ollama)
# Replace IP with your friend's LAN IP address (e.g., 192.168.1.45)
# =====================================================================
FRIEND_GPU_OLLAMA_URL=http://172.16.149.221:8001/v1
FRIEND_GPU_MODEL=qwen2.5:7b

# =====================================================================
# SECONDARY LLM: GROQ CLOUD API (Free, Fast Backup)
# Get key at: https://console.groq.com
# =====================================================================
# Supply this only through the runtime environment on the ASR host; do not commit it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================================
# TERTIARY LLM: LOCAL CPU OLLAMA (Emergency Offline Backup)
# =====================================================================
LOCAL_OLLAMA_URL=http://127.0.0.1:11434/v1
LOCAL_OLLAMA_MODEL=qwen2.5:1.5b

# =====================================================================
# REDIS SESSION STORE (Local Docker or Native)
# =====================================================================
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL_SECONDS=1800

# =====================================================================
# DEMO DEFAULT SEED CUSTOMER
# Matching Customer ID from 02_seed_data.sql
# =====================================================================
DEFAULT_DEMO_CUSTOMER_ID=00000000-0000-0000-0000-000000000001
